{
  "name"           : "match-docs",
  "version"        : "0.0.0",
  "private"        : true,
  "type"           : "module",
  "scripts"        : {
    "build:docs"  : "node scripts/build-docs.js",
    "build:mnist" : "node scripts/preprocess-mnist.js",
    "dev"         : "npm run build:docs && vite",
    "build"       : "npm run build:docs && tsc && vite build",
    "preview"     : "vite preview",
    "test"        : "vitest run",
    "format"      : "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies"   : {"mathjax": "^4.1.3", "pyodide": "^314.0.3"},
  "devDependencies": {
    "@types/node"            : "^26.1.2",
    "marked"                 : "^18.0.7",
    "oxfmt"                  : "^0.61.0",
    "typescript"             : "~6.0.2",
    "vite"                   : "^8.1.1",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest"                 : "^4.1.10"
  }
}
